# Database — leave unset to use repo-root data/metrics.db (recommended).
# Set to an absolute path or postgres:// URL only when deploying.
#DATABASE_URL=sqlite:////absolute/path/to/data/metrics.db

# CORS (frontend dev)
CORS_ORIGINS=["http://localhost:5173"]

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Garmin
# Email/password only needed for the first interactive login (scripts/garmin_login.py).
# After login, tokens persist in data/garmin_tokens/ — you can blank these lines.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Email (Resend) — weekly report
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WEEKLY_REPORT_TO_EMAIL=

# Scheduler
WEEKLY_REPORT_DAY=monday
WEEKLY_REPORT_HOUR=8
DAILY_SYNC_HOUR=7
SCHEDULER_TIMEZONE=America/Sao_Paulo

# Auth (leave APP_PASSWORD blank to disable — useful for local dev).
# Set both before exposing the app to the public internet.
APP_PASSWORD=
APP_SESSION_SECRET=
AUTH_COOKIE_SECURE=false  # set true when serving over HTTPS

# Production hardening (set true on Railway / any public deploy):
EXPOSE_DOCS=true            # set false in prod to hide /docs, /redoc, /openapi.json
ADD_SECURITY_HEADERS=false  # set true in prod to add HSTS, X-Frame-Options, CSP, etc
MAX_UPLOAD_BYTES=8388608    # 8 MB cap on file uploads
EXPENSIVE_OP_MAX_PER_WINDOW=6  # rate limit per IP per minute on briefing/report/upload
